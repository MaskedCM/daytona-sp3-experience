{
  "name": "daytona-sp3-experience",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Interactive Ferrari Daytona SP3 showroom, exploded assembly explorer and illustrative V12 mechanical lab.",
  "author": "MaskedCM",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --port 3000 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "tsx --test src/audio/soundEngine.test.ts src/utils/experience.test.ts src/utils/explosionGroups.test.ts src/utils/modelBounds.test.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "gsap": "3.15.1",
    "lucide-react": "0.546.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
